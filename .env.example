# ==========================================
# ALGORA ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Port of express + dev server
PORT=3000

# PostgreSQL Connection Pool URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/algora_db

# Security & Session JWT Keys
JWT_SECRET=algora_secure_development_jwt_secret_key_123!
JWT_REFRESH_SECRET=algora_secure_development_refresh_key_456!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# BullMQ & Redis Queue Setup
ENABLE_REDIS_QUEUE=false
REDIS_URL=redis://localhost:6379

# Google Gemini API key for socratic coaching mentors
VITE_GEMINI_API_KEY=
